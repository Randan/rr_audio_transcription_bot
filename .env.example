# Required - Telegram Bot API token
BOT_TOKEN=

# HTTP server bind address (use 0.0.0.0 in Docker to accept external requests)
HOST=0.0.0.0

# Server port for health and transcribe HTTP API (default 3000)
PORT=3000

# development | production
NODE_ENV=production

# Optional - Telegram chat ID for admin error notifications
ADMIN_TELEGRAM_ID=

# ElevenLabs Speech-to-Text
ELEVENLABS_API_KEY=
